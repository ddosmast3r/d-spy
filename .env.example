# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда слать уведомления: ваш user id или id группы (для группы число отрицательное)
TELEGRAM_CHAT_ID=

# Как часто проверять, в секундах (по умолчанию 10 минут)
POLL_INTERVAL=600

# Организации: id:Название через запятую.
# id берётся из ссылки вида https://yandex.ru/maps/org/<id>/
# Формат: id:Название  или  id:Название:quiet
# quiet — организация с редкими отзывами: кнопка «Последние» покажет только самый свежий
ORGS=30239245640:Чё? Шашлык,164390844914:Lovely Bag:quiet
